<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%--
────────────────────────────────────────────
 JSP 기본 구성 설명
────────────────────────────────────────────
 JSP는 실행 시 내부적으로 Servlet으로 변환된다.

 JSP 태그 종류
 1) 선언문 태그    <%!  %>  : 전역 변수, 메소드 선언 할 태그 영역 (클래스 영역)
 2) 스크립틀릿 태그 <%   %>  : 자바 실행 코드 작성할 태그 영역 (jsp_service 메소드 내부에 작성한 자바코드가 들어감)
 3) 표현식 태그    <%=  %>  : 값 출력 (out.print 자동 수행)
────────────────────────────────────────────
--%>


<%--
────────────────────────────────────────────
 1. 선언문 태그 영역
────────────────────────────────────────────
 - JSP가 Servlet 클래스로 변환될 때
   클래스 영역에 포함된다.
 - 전역 변수, 메소드 선언 가능
 - 모든 요청에서 공유됨
────────────────────────────────────────────
--%>    
<%!
	//전역변수 
	String name = "이순신";
	
	//메소드 
	public String getName(){  return this.name;  }
%>
<%--
────────────────────────────────────────────
 2. 스크립틀릿 태그 <%   %>영역
────────────────────────────────────────────
 - 클라이언트 요청이 들어올 때마다 실행
 - _jspService(HttpServletRequest, HttpServletResponse)
   메소드 내부에 포함됨
 - 지역 변수만 선언 가능
 - 메소드 선언 ❌
────────────────────────────────────────────
--%>   
<%
/*
[요청 흐름 정리]

1. 클라이언트 요청
   http://localhost:8181/pro12/hello2.jsp?age=22

2. 톰캣 동작 
   - 요청 하나당 HttpServletRequest 객체 생성
   - 요청 파라미터(age=22)를  HttpServletRequest 객체에 저장

3. hello2.jsp에서  HttpServletRequest 객체를 통해 요청 파라미터 값 꺼내 사용
*/ 	

	//요청 파라미터 age 값 가져오기 (문자열 "22"로 반환 됨)
	String age = request.getParameter("age");
    //     "22"
/*    
	주의 사항
	-  age 변수는  _jspService 메소드 내부 지역변수 로 만들어진다.
	-  그리고 age변수의 값은 이 작성한 스크립틀릿 태그 아랫 줄에서만  불러와 사용할수 있다.
*/ 	
%>
<%--
────────────────────────────────────────────
 3. 표현식 태그 영역
────────────────────────────────────────────
 - 변수나 메소드의 값을 웹 브라우저로 출력
 - 내부적으로 out.print() 수행
────────────────────────────────────────────
--%>
<h1>안녕하세요.<%=getName()%></h1>
<h1>나이는 <%=age%>살 입니다.</h1>
    
